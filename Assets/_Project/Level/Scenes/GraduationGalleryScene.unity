--- !u!114 &1908031138
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1908031136}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b66e06458dd714499a0aa6f9d37c10f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PanelDetector
  yoloModel: {fileID: 5022602860645237092, guid: 76ca47ddd7c0ed448921eebfcd47ac19, type: 3}
  backend: 512
  confidenceThreshold: 0.5
  iouThreshold: 0.45
  layersPerFrame: 20
  panelEntries:
  - panelName: College History Text
    characterPrefab: {fileID: 597805309522532133, guid: 94e8d3f92bf9eaf4f8e99d960b386a2b, type: 3}
    narrationClip: {fileID: 8300000, guid: e8287e056ac5f864cb13ef757cd408b2, type: 3}
    narrationTranscript: You are looking at the genesis of our institution... The
      establishment of the Faculty of Engineering at Fouad I University. Notice the
      massive crane hook beside it. That is no mere tool... it is a symbol of the
      immense heavy lifting required to build a nation. From these quiet classrooms
      to the construction sites... this is exactly where the minds that shaped modern
      Egypt... were forged.
    idleClip: {fileID: 7400000, guid: d09467bccff47b346b9fa6da5676b469, type: 2}
    talkingClip: {fileID: 7400000, guid: feb3fecf0aa02494bbed49ffe61310c6, type: 2}
  - panelName: Mechanical Engineering
    characterPrefab: {fileID: 5327342390939624010, guid: b525b1565ffcd5349848fe95ed0fbe4a, type: 3}
    narrationClip: {fileID: 8300000, guid: 6284497ff551f7045b3f4042eab2dd7e, type: 3}
    narrationTranscript: 'Look up at the iconic Dome of Cairo University... a true,
      enduring monument to education. Just below it, notice how a beautifully carved
      classical column stands right next to a heavy mechanical wheel. This perfectly
      captures our deepest philosophy... We teach our students to design with timeless,
      artistic beauty... while mastering the raw, powerful mechanics that drive the
      modern world. '
    idleClip: {fileID: 7400000, guid: d09467bccff47b346b9fa6da5676b469, type: 2}
    talkingClip: {fileID: 7400000, guid: feb3fecf0aa02494bbed49ffe61310c6, type: 2}
  - panelName: Mechanical Engineering
    characterPrefab: {fileID: 4154945946437003611, guid: 5190b692202d1b44fa8e552df81c29ea, type: 3}
    narrationClip: {fileID: 8300000, guid: 3bb647952e6d9f0468579ed7bf905792, type: 3}
    narrationTranscript: 'Here... you see the massive, beating heart of the early
      industrial age. This detailed drawing shows a steam engine and a relentless
      mechanical press. Over a century ago, mastering these powerful machines was
      the absolute cutting edge of human science. We taught our students how to safely
      harness extreme pressure and motion... to power the factories of a newly growing
      Egypt '
    idleClip: {fileID: 7400000, guid: d09467bccff47b346b9fa6da5676b469, type: 2}
    talkingClip: {fileID: 5528149604612604457, guid: ab37c3e3cdbfe524c86c3b5fca92c8e8, type: 3}
  - panelName: 
    characterPrefab: {fileID: 0}
    narrationClip: {fileID: 8300000, guid: 2521df9d5b7820e439bed09c13968e5b, type: 3}
    narrationTranscript: 
    idleClip: {fileID: 0}
    talkingClip: {fileID: 0}
  - panelName: 
    characterPrefab: {fileID: 0}
    narrationClip: {fileID: 8300000, guid: 57668c0bd9267fe429939a9af8d9d4bb, type: 3}
